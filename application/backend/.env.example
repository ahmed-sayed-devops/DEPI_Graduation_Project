# ---------------------------------------------------------------------------
# Backend configuration (12-factor). Copy to .env for local development only.
# In Kubernetes inject these via ConfigMap / Secret, never commit real values.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# MongoDB connection string (alias: MONGODB_URI). Example for a K8s service with auth:
MONGO_URI=mongodb://appuser:change-me@mongodb.database.svc.cluster.local:27017/restaurant?authSource=admin
# Secret used to sign session tokens (alias: JWT_SECRET). REQUIRED when NODE_ENV=production
# (the app refuses to start without it). Use a long random value (openssl rand -hex 32)
# and keep it IDENTICAL on every replica. Changing it logs every user out.
SESSION_SECRET=replace-with-a-long-random-string

# --- Optional ---------------------------------------------------------------
# Port the API listens on (binds to 0.0.0.0). Default: 3000
PORT=3000
# Runtime mode. Default: development
NODE_ENV=production
# Allowed CORS origin(s): '*' (default), one origin, or a comma-separated list.
# Not needed when the Gateway serves frontend and /api on the same domain.
CORS_ORIGIN=*
# Seed the default products after connecting to MongoDB. Default: true
# Seeding only inserts missing products (by name); it never deletes or changes existing ones.
SEED_DATABASE=true

# Behind a load balancer / Gateway, set this so the real client IP is used for login rate limiting.
# Number of proxy hops ("1" for a single ALB), "true", or a subnet/keyword (see Express "trust proxy").
# Default: not set (req.ip = the direct peer address).
# TRUST_PROXY=1
# Login attempts allowed per IP + email within the window. Defaults: 10 attempts / 900000 ms (15 min)
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=900000

# Keep-alive timeout in ms; must be longer than the load balancer idle timeout (ALB default: 60s). Default: 65000
# KEEP_ALIVE_TIMEOUT_MS=65000
# Set to false to disable the per-request access log. Default: true
# LOG_REQUESTS=true

# --- Optional DB connection retry tuning (milliseconds) ---------------------
# DB_RETRY_BASE_MS=1000
# DB_RETRY_MAX_MS=15000
# DB_SERVER_SELECTION_TIMEOUT_MS=5000
